<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.projectbeta.marketopen</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>--</string>
        <string>/Users/god/dev/Project-Beta/run_market_open.sh</string>
    </array>

    <!-- 06:30 local time = 09:30 ET, the opening bell. launchd uses the
         machine's local timezone. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/god/dev/Project-Beta</string>

    <key>StandardOutPath</key>
    <string>/Users/god/dev/Project-Beta/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/god/dev/Project-Beta/launchd.err.log</string>

    <!-- If the Mac was asleep or off at 06:30, run as soon as it wakes.
         Better a late run than none; the script stamps its own time so a
         late run is obvious in the log rather than silently misread. -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
